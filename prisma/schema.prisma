// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(cuid())
  keycloakId String?    @unique
  email      String     @unique
  username   String?
  createdAt  DateTime   @default(now())
  role       Role       @default(USER)
  points     Int        @default(0)
  photos     Photo[]
  analyses   Analysis[]
  reminders  Reminder[]
  subscriptionTier SubscriptionTier @default(FREE)

}

enum Role {
  USER
  ADMIN
}

model Photo {
  id        String   @id @default(uuid())
  url       String // The Cloudinary URL
  publicId  String // The Cloudinary Public ID
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Analysis {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  skinType    String // Oily, Dry, etc.
  healthScore Int // 0-100
  skinAge     Int
  summary     String @db.Text

  // Storing complex objects as JSON
  concerns       Json // List of issues found
  morningRoutine Json
  eveningRoutine Json

  imageUrl  String // Reference to the photo used
  createdAt DateTime @default(now())
}

model Reminder {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String
  time        String
  title       String
  description String?
  enabled     Boolean @default(true)
  days        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubscriptionTier {
  FREE
  SILVER
  GOLD
  PLATINUM
}
